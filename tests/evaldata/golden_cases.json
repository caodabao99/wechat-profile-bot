{
  "version": "eval-lab-v1",
  "note": "AI Evaluation Lab 黄金用例（V7 §18）。全部为虚拟数据，绝不包含真实用户聊天。每个 case 的 model_outputs 是「已录制的样本」，评测器在离线、确定性、零 LLM 依赖下打分；接真实模型时由 runner 用模型输出替换这些样本即可复用同一套指标/对比/回归逻辑。约定：model-a=理想、model-b=一般、model-c=坏输出(非法 JSON)。",
  "models": ["model-a", "model-b", "model-c"],
  "cases": [
    {
      "id": "fact-01", "task": "fact_extraction", "category": "Fact",
      "input": "对方说：我是一名中学老师，教数学。",
      "expect": {"must_be_valid_json": true, "required_fields": ["facts"], "expected_snippets": ["老师"], "forbidden_snippets": ["医生"], "min_evidence_refs": 0},
      "model_outputs": {
        "model-a": {"output": "{\"facts\":[\"职业:中学老师\",\"学科:数学\"]}", "latency_ms": 900, "tokens": 520},
        "model-b": {"output": "{\"facts\":[\"职业:老师\"]}", "latency_ms": 1300, "tokens": 610},
        "model-c": {"output": "对方好像是老师吧。", "latency_ms": 300, "tokens": 0}
      }
    },
    {
      "id": "fact-02", "task": "fact_extraction", "category": "Fact",
      "input": "她周末经常去跑步，参加过半马。",
      "expect": {"must_be_valid_json": true, "required_fields": ["facts"], "expected_snippets": ["跑步"], "forbidden_snippets": ["游泳"], "min_evidence_refs": 0},
