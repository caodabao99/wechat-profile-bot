      "model_outputs": {
        "model-a": {"output": "{\"evidence\":[{\"message_id\":11},{\"message_id\":23}]}", "latency_ms": 700, "tokens": 380},
        "model-b": {"output": "{\"evidence\":[{\"message_id\":11}]}", "latency_ms": 950, "tokens": 400},
        "model-c": {"output": "证据在聊天里。", "latency_ms": 200, "tokens": 0}
      }
