      "model_outputs": {
        "model-a": {"output": "{\"facts\":[\"子女:女儿\",\"学龄:小学三年级\"]}", "latency_ms": 910, "tokens": 530},
        "model-b": {"output": "{\"facts\":[\"有孩子\"]}", "latency_ms": 1250, "tokens": 540},
        "model-c": {"output": "", "latency_ms": 100, "tokens": 0}
