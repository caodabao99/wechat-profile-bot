        "model-a": {"output": "{\"facts\":[\"爱好:跑步\",\"经历:半程马拉松\"]}", "latency_ms": 880, "tokens": 500},
        "model-b": {"output": "{\"facts\":[\"喜欢运动\"]}", "latency_ms": 1200, "tokens": 560},
        "model-c": {"output": "{bad json", "latency_ms": 250, "tokens": 0}
      }
    },
    {
      "id": "fact-03", "task": "fact_extraction", "category": "Fact",
      "input": "他有个女儿，今年上小学三年级。",
